COMPOSE_PROFILES=datahub,wzam_keycloak,wzam_nginx,mongo_full,kafka_full,kafka_connect

DOCKER_HOST_IP=

DB_HOST=${DOCKER_HOST_IP}
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres
 
# Keycloak authentication crendentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Parameters - to generate secret key use a password generator such as: https://www.avast.com/en-us/random-password-generator#pc and set the length to 32
KEYCLOAK_REALM=wzam
KEYCLOAK_API_CLIENT_ID=wzam-api-client
KEYCLOAK_API_CLIENT_SECRET_KEY=X9vL3pQ7mN2kT8wR5yJd
KEYCLOAK_ENDPOINT=${DOCKER_HOST_IP}:8084

# Nginx Parameters

# Nginx encryption options: "plain", "ssl"
# Note that this just changes the config file attached as a volume to the Nginx container
NGINX_ENCRYPTION="plain"
NGINX_KC_ENDPOINT=${DOCKER_HOST_IP}:8084

# SSL file name in path /docker/nginx/ssl/
SERVER_CERT_FILE=nginx_server.crt
SERVER_KEY_FILE=nginx_server.key
CA_CERT_FILE=ca.crt

# Nginx server host
WZAM_SERVER_HOST=${DOCKER_HOST_IP}

MONGO_CREATE_INDEXES_SCRIPT_RELATIVE_PATH="../resources/mongo/create_indexes.js"
KAFKA_TOPICS_VALUES_FILE="../resources/kafka/kafka-topics-values.yaml"
CONNECT_KAFKA_CONNECTORS_VALUES_FILE="../resources/kafka/kafka-connectors-values.yaml"

# MongoDB
MONGO_HOST_IP=${DOCKER_HOST_IP}
MONGO_API_USERNAME=admin
MONGO_API_PASSWORD=replace_me
MONGO_AUTH_DB=admin
MONGO_DB_NAME=datahub

# Kafka
KAFKA_BROKER_IP=${DOCKER_HOST_IP}
KAFKA_BROKER_PORT=9092

# iCone Ingest
ICONE_INGEST_ENABLED=true
ICONE_INGEST_URL=
ICONE_INGEST_API_KEY=
ICONE_INGEST_PERIOD=5m
ICONE_INGEST_MAX_AGE=30m
ICONE_INGEST_UPDATES_ENABLED=true

# Ver-Mac Ingest
VER_MAC_INGEST_ENABLED=true
VER_MAC_INGEST_URL=
VER_MAC_INGEST_API_KEY=
VER_MAC_INGEST_PERIOD=5m
ICONE_INGEST_MAX_AGE=30m
VER_MAC_INGEST_UPDATES_ENABLED=true

# Wanco Ingest
WANCO_INGEST_ENABLED=true
WANCO_INGEST_URL=
WANCO_INGEST_TOKEN_LIFESPAN=15m
WANCO_INGEST_API_KEY=
WANCO_INGEST_PERIOD=5m
WANCO_INGEST_MAX_AGE=1h
WANCO_INGEST_UPDATES_ENABLED=true

# Pi-Lit Ingest
PI_LIT_INGEST_ENABLED=true
PI_LIT_INGEST_URL=
PI_LIT_INGEST_TOKEN_LIFESPAN=24h
PI_LIT_INGEST_USERNAME=
PI_LIT_INGEST_PASSWORD=
PI_LIT_INGEST_PERIOD=5m
PI_LIT_INGEST_MAX_AGE=1h
PI_LIT_INGEST_UPDATES_ENABLED=true

# WZAM Ingest
WORKER_LOCATION_UPDATES_ENABLED=true
VEHICLE_LOCATION_UPDATES_ENABLED=true
## Worker
WZAM_WORKER_INGEST_MONITOR_ENABLED=true
WZAM_WORKER_INGEST_MONITOR_EVAL_PERIOD=5m
WZAM_WORKER_INGEST_MAX_AGE=15m
## Vehicle
WZAM_VEHICLE_INGEST_MONITOR_ENABLED=true
WZAM_VEHICLE_INGEST_MONITOR_EVAL_PERIOD=1m
WZAM_VEHICLE_INGEST_MAX_AGE=5m

# GIS Server
GIS_SERVER_ENDPOINT=

# Root api path for proxy config, must begin with a slash
DATAHUB_BASE_API_PATH="/datahub"
MESSAGE_GENERATOR_BASE_API_PATH="/message-generator"
WZAM_BASE_API_PATH="/wzam"

# Keycloak admin emails shown to newly registered users to request access
KEYCLOAK_ADMIN_REGISTRATION_EMAILS=

# jpo-utils
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=replace_me

# Slack Notifications
SLACK_NOTIFICATION_NEW_USER_REGISTRATION_ENABLED=false
SLACK_NOTIFICATION_NEW_USER_REGISTRATION_WEBHOOK_URL=
SLACK_NOTIFICATION_SUPPORT_REQUEST_ENABLED=false
SLACK_NOTIFICATION_SUPPORT_REQUEST_WEBHOOK_URL=

APP_MINIMUM_VERSION=
APP_LATEST_VERSION=

# Email (SMTP)
MAIL_HOST=
MAIL_PORT=25
EMAIL_FROM_ADDRESS=no-reply@wyo.gov
