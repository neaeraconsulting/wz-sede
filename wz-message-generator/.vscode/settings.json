{
  "editor.formatOnSave": true,
  "editor.rulers": [80], // Adds a visual ruler at 80 characters
  "editor.detectIndentation": false,
  "cSpell.words": [
    "backchannel",
    "bbox",
    "conadmin",
    "Configurer",
    "creationtime",
    "csvfile",
    "datahub",
    "fasterxml",
    "frontchannel",
    "HDOP",
    "Icone",
    "LINESTRING",
    "Lngs",
    "millis",
    "MULTIPOINT",
    "pjson",
    "updatetime",
    "userinfo",
    "wydot",
    "wzam",
    "wzdx"
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "[java]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "java.debug.settings.onBuildFailureProceed": true,
  "java.compile.nullAnalysis.mode": "automatic"
}
